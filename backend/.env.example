POSTGRES_USER=
POSTGRES_PASSWORD=
# Password for sandbox_reader (read-only access to analytics_training).
SANDBOX_DB_PASSWORD=
SANDBOX_DB_HOST=127.0.0.1
SANDBOX_DB_PORT=5432
DB_HOST=
DB_PORT=
DATABASES=1_db,2_db,...

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

OPENCODE_SERVER_PASSWORD=

# Generate a random token (at least 32 characters), shared ONLY by API and runner.
SANDBOX_RUNNER_TOKEN=
SANDBOX_RUNNER_ENDPOINT=http://127.0.0.1:8090
SANDBOX_IMAGE=analytics-sandbox:1.0
SANDBOX_RUNTIME=runc
SANDBOX_CONCURRENCY=3
SANDBOX_HEAVY_CONCURRENCY=1
# Profile overrides: "lesson_id:exercise_id" -> profile. Default: light.
SANDBOX_ASSIGNMENT_PROFILES={"123:python-1":"standard"}
# Optional Docker socket source path for Compose (Docker Desktop/rootless Docker).
# SANDBOX_DOCKER_SOCKET=/var/run/docker.sock

# AI mentor: never calls Gemini without the explicit Xray HTTP proxy.
GEMINI_API_KEY=
GEMINI_PROXY_URL=http://127.0.0.1:10810
# Comma-separated priority list (max 5). Only HTTP 429 triggers the next model.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_USER_DAILY_LIMIT=50
GEMINI_USER_MINUTE_LIMIT=5
