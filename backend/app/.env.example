#настройки бд
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=core_db
DB_USER=
DB_PASSWORD=
DB_ADMIN_DB=postgres

# API
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
IS_PRODUCT=true

# MINIO/S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

IMAGE_URL_TTL=3600
CONTENT_URL_TTL=3600
VIDEO_URL_TTL=7200
UPLOAD_URL_TTL=900
MAX_TEXT_FILE_SIZE=1048576
LESSON_CONTENT_MAX_UPLOAD_SIZE=512000

# REQUEST LIMITS
MAX_STANDARD_BODY_SIZE=10485760

# IP/PROXY
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.18.0.0/16
GEOIP_DB_PATH=utils/GeoLite2-Country.mmdb

# CORS/CSRF (домены фронтенда через запятую)
CORS_ORIGINS=

# SESSIONS
SESSION_TTL_DAYS=180
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

# RATE LIMIT
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# MINIO
MINIO_PRESIGN_CONCURRENCY=10

# AI mentor (host backend). Only the key is required; other values are defaults.
DEEPSEEK_API_KEY=
MODEL="deepseek-flash"
MAX_TOKENS=1024
THINKING="disabled"
DEEPSEEK_USER_DAILY_LIMIT=50
DEEPSEEK_USER_MINUTE_LIMIT=5
DEEPSEEK_PROJECT_DAILY_LIMIT=200
DEEPSEEK_PROJECT_MINUTE_LIMIT=10
DEEPSEEK_MAX_INPUT_BYTES=18000
