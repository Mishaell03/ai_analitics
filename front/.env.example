# В dev запросы идут на тот же origin и проксируются Vite на backend.
# Так браузер не требует CORS и cookie-сессия работает как same-origin.
VITE_API_URL=/api/v1

# Разрешить просмотр соседних уроков без изменения прогресса (true/false).
VITE_LESSON_ALLOW_BROWSING=true

# Куда Vite проксирует /api (по умолчанию http://localhost:8000)
VITE_API_PROXY_TARGET=http://localhost:8000
